# EmailJS credentials for the contact form (https://dashboard.emailjs.com/)
# Create your own EmailJS service + template, then copy this file to `.env` and fill these in.
# Without these three values the contact form shows "COMM_LINK_UNCONFIGURED" instead of sending.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
